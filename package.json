{
  "name": "public_share_control",
  "version": "1.0.0",
  "private": true,
  "description": "Control what visitors can create and simplify uploads on public share links.",
  "keywords": [
    "nextcloud",
    "sharing",
    "public-link",
    "upload"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Nico Störzbach",
  "type": "module",
  "scripts": {
    "build": "vite build --mode production",
    "dev": "vite build --mode development",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "screenshots": "playwright test --config dev/screenshots.config.ts",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "watch": "vite build --mode development --watch"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@nextcloud/axios": "^2.5.2",
    "@nextcloud/dialogs": "^7.4.1",
    "@nextcloud/event-bus": "^3.3.1",
    "@nextcloud/files": "^4.0.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.0",
    "@nextcloud/logger": "^3.0.2",
    "@nextcloud/password-confirmation": "^6.1.0",
    "@nextcloud/paths": "^3.1.0",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/sharing": "^0.4.0",
    "@nextcloud/vue": "^9.9.0",
    "vue": "^3.5.41",
    "vue-material-design-icons": "^5.3.1"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/vite-config": "^2.5.2",
    "@playwright/test": "^1.63.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "happy-dom": "^20.14.5",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  }
}
